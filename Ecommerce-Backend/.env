# Identity MySQL
MYSQL_DATABASE=identity_db
MYSQL_USER=identity_user
MYSQL_PASSWORD=identity_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_PORT=3306

# Catalog MongoDB
CATALOG_MONGO_DATABASE=catalog_db
CATALOG_MONGO_USERNAME=catalog_user
CATALOG_MONGO_PASSWORD=catalog_password
CATALOG_MONGO_PORT=27017

# Inventory PostgresSQL
INVENTORY_DB_NAME=inventory_db
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=inventory_password
INVENTORY_DB_PORT=5432

# Cart Redis
CART_REDIS_HOST=cart-redis
CART_REDIS_PORT=6379

# Order PostgresSQL
ORDER_DB_NAME=order_db
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=order_password
ORDER_DB_PORT=5433

# Payment PostgresSQL
PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=payment_password
PAYMENT_DB_PORT=5434

# Notification PostgresSQL
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=notification_password
